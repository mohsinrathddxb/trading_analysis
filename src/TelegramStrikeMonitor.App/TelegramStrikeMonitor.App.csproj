<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TelegramStrikeMonitor</AssemblyName>
    <RootNamespace>TelegramStrikeMonitor.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\python\live_strike_monitor.py">
      <Link>python\live_strike_monitor.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\python\monitor_config.json">
      <Link>python\monitor_config.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\python\requirements.txt">
      <Link>python\requirements.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\python\.env.example">
      <Link>python\.env.example</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
