<Window x:Class="TelegramStrikeMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telegram Strike Monitor"
        Width="1320"
        Height="850"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Telegram Strike Monitor" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Telegram catch-up, OCR, strike comparison and easy market reports" Foreground="#BAC6D8" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#7A879A" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Stopped" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Monitor controls" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Select how the Python engine should run." Foreground="{StaticResource TextSecondary}" Margin="0,4,0,12"/>

                            <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModeComboBox" SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="Today catch-up + live monitoring" Tag="--today-and-live"/>
                                <ComboBoxItem Content="Live monitoring only" Tag="--live-only"/>
                                <ComboBoxItem Content="Process downloaded images and stop" Tag="--existing-only"/>
                            </ComboBox>

                            <WrapPanel>
                                <Button x:Name="StartButton" Content="Start monitor" Click="StartButton_Click"/>
                                <Button x:Name="StopButton" Content="Stop" Style="{StaticResource DangerButton}" IsEnabled="False" Click="StopButton_Click"/>
                            </WrapPanel>
                            <Button Content="Regenerate downloaded-image reports" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="RegenerateButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Engine paths" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="The app keeps the existing Python analysis engine." Foreground="{StaticResource TextSecondary}" Margin="0,4,0,12" TextWrapping="Wrap"/>

                            <TextBlock Text="Python executable" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PythonPathTextBox"/>
                                <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowsePythonButton_Click"/>
                            </Grid>

                            <TextBlock Text="Python engine folder" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="EngineFolderTextBox" IsReadOnly="True" Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Content="Open .env" Style="{StaticResource SecondaryButton}" Click="OpenEnvButton_Click"/>
                                <Button Content="Open config" Style="{StaticResource SecondaryButton}" Click="OpenConfigButton_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Project folders" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <Button Content="Images" Style="{StaticResource SecondaryButton}" Click="OpenImagesButton_Click"/>
                                <Button Content="Reports" Style="{StaticResource SecondaryButton}" Click="OpenReportsButton_Click"/>
                                <Button Content="OCR debug" Style="{StaticResource SecondaryButton}" Click="OpenDebugButton_Click"/>
                                <Button Content="Database" Style="{StaticResource SecondaryButton}" Click="OpenDatabaseFolderButton_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Current totals" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Downloaded images" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="ImageCountText" Grid.Column="1" Text="0" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Text="Generated reports" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="ReportCountText" Grid.Row="1" Grid.Column="1" Text="0" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2" Text="Last report" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="LastReportTimeText" Grid.Row="2" Grid.Column="1" Text="—" FontWeight="Bold" Margin="12,6,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.9*"/>
                    <RowDefinition Height="1.1*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Latest easy report" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="LatestReportNameText" Text="No report loaded" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,10"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshReportButton_Click"/>
                        </Grid>
                        <TextBox x:Name="LatestReportTextBox"
                                 Grid.Row="1"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 Background="#FAFBFD"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Live engine log" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Python output and processing errors appear here." Foreground="{StaticResource TextSecondary}" Margin="0,3,0,10"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButton}" Click="ClearLogButton_Click"/>
                        </Grid>
                        <TextBox x:Name="LogTextBox"
                                 Grid.Row="1"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 Background="#101826"
                                 Foreground="#DDE7F4"
                                 BorderThickness="0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#E6ECF4" Padding="12,5">
            <TextBlock x:Name="FooterText" Text="Ready. Configure .env before starting." Foreground="{StaticResource TextSecondary}"/>
        </Border>
    </Grid>
</Window>
